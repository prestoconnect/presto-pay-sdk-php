{
  "name": "prestouniverse/presto-pay-sdk",
  "description": "Presto Pay merchant SDK for PHP",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {"PrestoUniverse\\PrestoPay\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"PrestoUniverse\\PrestoPay\\Tests\\": "tests/"}
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "check": ["@test", "@analyse"]
  },
  "config": {
    "platform": {"php": "8.2.0"}
  }
}
